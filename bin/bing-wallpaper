#!/bin/bash
# bing-wallpaper — download Microsoft's daily/curated images and cycle them as the wallpaper.
#
# Sources, both saved to ~/Pictures/bing:
#   - Bing daily wallpaper (the desktop feed, last 8 days)
#   - Windows Spotlight  (the lock/login screen feed, curated UHD landscapes)
#
# Usage:
#   bing-wallpaper fetch     # download both Bing + Spotlight images into the archive
#   bing-wallpaper bing      # download Bing images only
#   bing-wallpaper spotlight # download Windows Spotlight images only
#   bing-wallpaper next      # advance wallpaper to the next image in the archive (wraps around)
#   bing-wallpaper prev      # go back to the previous image
#   bing-wallpaper random    # pick a random image from the archive
#   bing-wallpaper           # fetch, then show the newest image
#
# Config via env:
#   BING_MARKET=en-US   (set to "auto" to let Bing choose by IP)
#   BING_RES=UHD        (preferred res; falls back to lower if unavailable)
#   BING_COUNT=8        (how many recent days to fetch; Bing's feed only goes
#                        back ~16 days, so higher values are capped to that)
#   SPOTLIGHT_POLLS=8   (how many times to poll the rotating Spotlight feed per
#                        run; more polls surface more of the curated catalog)
#
# Images are downloaded once at the best available resolution and kept
# permanently in ~/Pictures/bing (the archive is never pruned).

set -euo pipefail

MARKET="${BING_MARKET:-en-US}"
RES="${BING_RES:-UHD}"
COUNT="${BING_COUNT:-8}"
SPOTLIGHT_POLLS="${SPOTLIGHT_POLLS:-8}"
DEST_DIR="$HOME/Pictures/bing"
CURRENT_BACKGROUND_LINK="$HOME/.config/omarchy/current/background"

mkdir -p "$DEST_DIR"

usage() {
  cat <<'EOF'
bing-wallpaper — download Microsoft's daily/curated images and cycle them as the wallpaper.

USAGE
  bing-wallpaper [command]

COMMANDS
  fetch       Download both Bing and Spotlight images into the archive
  bing        Download Bing daily images only
  spotlight   Download Windows Spotlight images only
  next        Advance the wallpaper to the next image (wraps around)
  prev        Go back to the previous image
  random      Pick a random image from the archive
  newest      Show the most recent image in the archive
  help        Show this help (also -h, --help)
  (none)      Fetch new images, then show the newest one

ENVIRONMENT
  BING_MARKET      Bing market, e.g. en-US. Use "auto" to let Bing pick by IP   (default: en-US)
  BING_RES         Preferred resolution; falls back to lower if unavailable     (default: UHD)
  BING_COUNT       Recent days of Bing images to fetch (feed reaches back ~16)  (default: 8)
  SPOTLIGHT_POLLS  Times to poll the rotating Spotlight feed per run            (default: 8)

ARCHIVE
  Images are downloaded once at the best available resolution and kept
  permanently in ~/Pictures/bing (the archive is never pruned).
EOF
}

slugify() { echo "$1" | tr -cs '[:alnum:]' '-' | sed 's/^-//;s/-$//'; }

# Turn an archive filename back into a human-readable "Title (Source)" label.
#   bing-20260530-mountain-lake.jpg -> "Mountain lake (Bing)"
#   spotlight-coastal-cliffs.jpg    -> "Coastal cliffs (Spotlight)"
pretty_name() {
  local base name source
  base="$(basename "$1")"
  base="${base%.*}"
  case "$base" in
    bing-*)      source="Bing";      name="$(sed -E 's/^bing-[0-9]{8}-//' <<<"$base")" ;;
    spotlight-*) source="Spotlight"; name="${base#spotlight-}" ;;
    *)           source="";          name="$base" ;;
  esac
  name="${name//-/ }"
  [[ -n "$name" ]] || name="image"
  if [[ -n "$source" ]]; then echo "$name ($source)"; else echo "$name"; fi
}

# Desktop notification naming the wallpaper, using the image as the icon.
# No-op if notify-send is unavailable (e.g. headless). The synchronous hint
# makes rapid next/prev replace the previous toast instead of stacking.
notify_wallpaper() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a "Bing Wallpaper" -i "$1" \
    -h string:x-canonical-private-synchronous:bing-wallpaper \
    "Wallpaper updated" "$(pretty_name "$1")" 2>/dev/null || true
}

# Bing's daily images (the desktop wallpaper feed) — most recent $COUNT days.
# The API serves at most 8 images per request and only reaches back ~16 days,
# so we page through it in chunks of 8 (idx=0,8,…) and stop once it stops
# returning dates we haven't already seen (i.e. it has clamped idx).
fetch_bing() {
  local idx=0 want api meta n i urlbase startdate title outfile res new_in_page
  local -A seen=()

  while ((${#seen[@]} < COUNT)); do
    want=$((COUNT - ${#seen[@]}))
    ((want > 8)) && want=8
    api="https://www.bing.com/HPImageArchive.aspx?format=js&idx=$idx&n=$want"
    [[ "$MARKET" != "auto" ]] && api+="&mkt=$MARKET"
    meta="$(curl -fsSL "$api")" || break

    n="$(jq '.images | length' <<<"$meta")"
    ((n == 0)) && break

    new_in_page=0
    for ((i = 0; i < n; i++)); do
      startdate="$(jq -r ".images[$i].startdate" <<<"$meta")"
      [[ -n "${seen[$startdate]:-}" ]] && continue
      seen[$startdate]=1
      new_in_page=1

      urlbase="$(jq -r ".images[$i].urlbase" <<<"$meta")"
      title="$(jq -r ".images[$i].title // \"bing\"" <<<"$meta")"
      [[ -z "$urlbase" || "$urlbase" == "null" ]] && continue

      outfile="$DEST_DIR/bing-${startdate}-$(slugify "$title").jpg"
      [[ -f "$outfile" ]] && continue

      # Download once at the best available resolution (try preferred, then fall back)
      for res in "$RES" 3840x2160 1920x1200 1920x1080 1366x768; do
        curl -fsSL "https://www.bing.com${urlbase}_${res}.jpg" -o "$outfile" && break
      done
    done

    ((new_in_page == 0)) && break   # API clamped idx; no older images available
    idx=$((idx + n))
  done
}

# Windows Spotlight images (the lock/login screen feed) — curated UHD landscapes.
# The feed has no date index: each call returns a rotating handful (the server
# caps the batch at 4 regardless of what we ask), so to grow the archive we
# poll it $SPOTLIGHT_POLLS times per run and let the filename de-dupe overlaps.
fetch_spotlight() {
  local api resp asset title outfile item poll
  api="https://fd.api.iris.microsoft.com/v4/api/selection?placement=88000820&bcnt=4&country=${MARKET#*-}&locale=${MARKET}&fmt=json"

  for ((poll = 0; poll < SPOTLIGHT_POLLS; poll++)); do
    resp="$(curl -fsSL "$api")" || return 0

    while IFS= read -r item; do
      asset="$(jq -r '.ad.landscapeImage.asset // empty' <<<"$item")"
      title="$(jq -r '.ad.title // "spotlight"' <<<"$item")"
      [[ -z "$asset" ]] && continue

      outfile="$DEST_DIR/spotlight-$(slugify "$title").jpg"
      [[ -f "$outfile" ]] && continue
      curl -fsSL "$asset" -o "$outfile" || true
    done < <(jq -c '.batchrsp.items[].item | fromjson' <<<"$resp" 2>/dev/null)
  done
}

fetch() {
  fetch_bing
  fetch_spotlight
}

# List archive images, sorted (oldest -> newest by date-prefixed filename)
list_images() {
  find -L "$DEST_DIR" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.png' \) | sort
}

apply() {
  local file="$1"
  ln -nsf "$file" "$CURRENT_BACKGROUND_LINK"

  if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    local rt sock
    rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    sock="$(find "$rt" -maxdepth 1 -name 'wayland-[0-9]*' ! -name '*.lock' -printf '%f\n' 2>/dev/null | sort | head -n1)"
    [[ -n "$sock" ]] && export WAYLAND_DISPLAY="$sock"
  fi

  if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    pkill -x swaybg 2>/dev/null || true
    if command -v uwsm-app >/dev/null 2>&1; then
      setsid uwsm-app -- swaybg -i "$CURRENT_BACKGROUND_LINK" -m fill >/dev/null 2>&1 &
    else
      setsid swaybg -i "$CURRENT_BACKGROUND_LINK" -m fill >/dev/null 2>&1 &
    fi
  fi
  notify_wallpaper "$file"
  echo "$file"
}

# step <+1|-1> — move through the archive relative to the current image
step() {
  local dir="$1"
  mapfile -t imgs < <(list_images)
  ((${#imgs[@]} == 0)) && { echo "bing-wallpaper: no images yet, run 'bing-wallpaper fetch'" >&2; exit 1; }

  local current index=-1 i
  current="$(readlink "$CURRENT_BACKGROUND_LINK" 2>/dev/null || true)"
  for i in "${!imgs[@]}"; do
    [[ "${imgs[$i]}" == "$current" ]] && { index=$i; break; }
  done
  # wrap-around modulo that stays positive
  local n=${#imgs[@]}
  local new=$(((index + dir + n) % n))
  apply "${imgs[$new]}"
}

random() {
  mapfile -t imgs < <(list_images)
  ((${#imgs[@]} == 0)) && { echo "bing-wallpaper: no images yet, run 'bing-wallpaper fetch'" >&2; exit 1; }
  apply "${imgs[RANDOM % ${#imgs[@]}]}"
}

newest() {
  mapfile -t imgs < <(list_images)
  ((${#imgs[@]} == 0)) && { echo "bing-wallpaper: no images yet" >&2; exit 1; }
  apply "${imgs[-1]}"
}

case "${1:-default}" in
  fetch)     fetch ;;
  bing)      fetch_bing ;;
  spotlight) fetch_spotlight ;;
  next)      step +1 ;;
  prev)      step -1 ;;
  random)    random ;;
  newest)    newest ;;
  default)   fetch; newest ;;
  help|-h|--help) usage ;;
  *) echo "bing-wallpaper: unknown command '$1'" >&2; echo >&2; usage >&2; exit 1 ;;
esac
